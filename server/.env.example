# ---- AI provider configuration (server-side only; never expose to the frontend) ----
# Provider: "openai-compatible" (works with OpenAI, Groq, OpenRouter, Together, local Ollama, etc.)
# or "anthropic".
AI_PROVIDER=openai-compatible
# Your API key. The app builds and runs without it, but note generation
# returns a clear configuration message until a real key is set here.
AI_API_KEY=
# Model to use. Defaults: gpt-4o-mini (openai-compatible) / claude-3-5-haiku-latest (anthropic).
AI_MODEL=gpt-4o-mini
# Only for openai-compatible providers. Examples:
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1
# Request timeout in milliseconds.
AI_TIMEOUT_MS=60000

# ---- Limits ----
PORT=4000
MAX_FILE_MB=10
MAX_TOTAL_CHARS=200000
CHUNK_CHARS=12000
MIN_INPUT_CHARS=50
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000

# Only needed if the frontend is hosted on a different origin.
# CORS_ORIGIN=http://localhost:5173
